GXX = gcc
OUTPUT_DIR = build/

CLIENT_SOURCE_DIR = Client
CLIENT_SOURCE_FILES = $(CLIENT_SOURCE_DIR)/main.c $(CLIENT_SOURCE_DIR)/src/client.c 
CLIENT_TARGET = client

SERVER_SOURCE_DIR = Server
SERVER_SOURCE_FILES = $(SERVER_SOURCE_DIR)/main.c $(SERVER_SOURCE_DIR)/src/server.c 
SERVER_TARGET = server

ARGS ?= 'localhost'

$(CLIENT_TARGET):
	$(GXX) -o $(OUTPUT_DIR)$(CLIENT_TARGET) $(CLIENT_SOURCE_FILES) 

$(SERVER_TARGET):
	$(GXX) -o $(OUTPUT_DIR)$(SERVER_TARGET) $(SERVER_SOURCE_FILES) 

all: $(CLIENT_TARGET) $(SERVER_TARGET)

up_server : $(SERVER_TARGET)
	$(OUTPUT_DIR)$(SERVER_TARGET)

up_client : $(CLIENT_TARGET)
	$(OUTPUT_DIR)$(CLIENT_TARGET) $(ARGS)